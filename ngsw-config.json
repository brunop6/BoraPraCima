{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/favicon.ico",
          "/marca/emblema-144.png",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "marca",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/marca/**"]
      }
    },
    {
      "name": "fontes",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ]
}
